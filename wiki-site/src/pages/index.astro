---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from '../components/GlassCard.astro';
import siteData from '../data/site-data.json';

const docs = await getCollection('docs');
const metrics = siteData.metrics || [];
const storyPillars = siteData.storyPillars || [];
const featuredDocs = siteData.featuredDocs || [];
const visualHighlights = siteData.visualHighlights || [];
const notebooklmHighlights = siteData.notebooklmHighlights || [];

const categories: Record<string, typeof docs> = {};
for (const doc of docs) {
  const category = (doc.data.category || 'general').toString();
  if (!categories[category]) categories[category] = [];
  categories[category].push(doc);
}
for (const category of Object.keys(categories)) {
  categories[category].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
}
const categoryLabels: Record<string, string> = {
  general: 'Portal & Research',
  product: 'Product',
  brand: 'Brand System',
  audience: 'Audience',
  marketing: 'Campaign',
};
const orderedCategories = Object.entries(categories).sort(([a], [b]) => {
  const order = ['general', 'product', 'brand', 'audience', 'marketing'];
  return (order.indexOf(a) === -1 ? 99 : order.indexOf(a)) - (order.indexOf(b) === -1 ? 99 : order.indexOf(b));
});
---

<BaseLayout title={`${siteData.brandName} Launch Portal`} description={siteData.heroSubtitle || siteData.tagline}>
  <section class="home-stage">
    <section class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{siteData.themeName} · {siteData.launchChannel}</p>
        <h1>{siteData.heroTitle}</h1>
        <p class="hero-subtitle">{siteData.heroSubtitle}</p>
        {siteData.heroDescription && <p class="hero-description">{siteData.heroDescription}</p>}

        <div class="hero-actions">
          <a class="cta cta--primary" href={siteData.heroPrimaryHref || '/docs/product/overview'}>Explore the product story</a>
          <a class="cta cta--secondary" href={siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts'}>Open research & NotebookLM</a>
        </div>

        {storyPillars.length > 0 && (
          <div class="story-pillars">
            {storyPillars.map((pillar) => <span class="pill pill--soft">{pillar}</span>)}
          </div>
        )}

        {metrics.length > 0 && (
          <div class="metric-grid">
            {metrics.map((metric) => (
              <GlassCard class="metric-card" tone="warm">
                <strong>{metric.value}</strong>
                <span>{metric.label}</span>
              </GlassCard>
            ))}
          </div>
        )}
      </div>

      <GlassCard class="hero-visual-card" tone="accent">
        <div class="hero-visual-card__frame">
          {siteData.heroImage && <img src={siteData.heroImage} alt={siteData.heroImageAlt || siteData.brandName} />}
        </div>
        <div class="hero-visual-card__copy">
          <p class="eyebrow">Launch-ready portal</p>
          <h2>{siteData.brandName}</h2>
          <p>{siteData.tagline}</p>
        </div>
        <div class="launch-facts">
          {(siteData.launchFacts || []).map((fact) => (
            <div class="launch-fact">
              <small>{fact.label}</small>
              <strong>{fact.value}</strong>
            </div>
          ))}
        </div>
      </GlassCard>
    </section>

    <section class="home-section">
      <div class="section-heading">
        <p class="eyebrow">Curated launch tracks</p>
        <h2>A brand portal first, but still a real wiki underneath</h2>
        <p>Move through product, brand, research, and campaign work without losing deep document access.</p>
      </div>
      <div class="feature-grid">
        {featuredDocs.map((doc) => (
          <GlassCard class="feature-card" interactive href={doc.href} tone="default">
            <p class="feature-card__eyebrow">{doc.eyebrow}</p>
            <h3>{doc.icon ? `${doc.icon} ${doc.title}` : doc.title}</h3>
            <p>{doc.description}</p>
            <span class="feature-link">Open section →</span>
          </GlassCard>
        ))}
      </div>
    </section>

    <section class="home-section">
      <div class="section-heading">
        <p class="eyebrow">Visual world</p>
        <h2>Use the actual brand surfaces, not just generic documentation cards</h2>
      </div>
      <div class="visual-grid">
        {visualHighlights.map((item) => (
          <GlassCard class="visual-card" interactive href={item.href} tone="signal">
            {item.image && <img src={item.image} alt={item.title} class="visual-card__image" />}
            <div class="visual-card__copy">
              <p class="feature-card__eyebrow">{item.eyebrow}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="feature-link">Review the context →</span>
            </div>
          </GlassCard>
        ))}
      </div>
    </section>

    <section class="home-section home-section--dual">
      <GlassCard class="knowledge-map" tone="default">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">Knowledge map</p>
          <h2>Browse the wiki by track</h2>
        </div>
        <div class="knowledge-map__grid">
          {orderedCategories.map(([category, categoryDocs]) => (
            <section class="knowledge-map__section">
              <p class="feature-card__eyebrow">{categoryLabels[category] || category}</p>
              <ul>
                {categoryDocs.map((doc) => (
                  <li>
                    <a href={`/docs/${doc.slug}`}>
                      {doc.data.icon && <span>{doc.data.icon} </span>}
                      {doc.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </GlassCard>

      <GlassCard class="research-panel" tone="warm">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">NotebookLM spotlight</p>
          <h2>Research and learning artifacts stay close to the story</h2>
        </div>
        <div class="research-panel__list">
          {notebooklmHighlights.map((item) => (
            <a class="research-item" href={item.href || siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts'}>
              {item.image && <img src={item.image} alt={item.title} class="research-item__image" />}
              <div>
                <p class="feature-card__eyebrow">{item.kind}</p>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="feature-link">Open in the wiki →</span>
              </div>
            </a>
          ))}
        </div>
      </GlassCard>
    </section>

    <section class="home-section">
      <GlassCard class="closing-banner" tone="accent">
        <div>
          <p class="eyebrow">Fresh build</p>
          <h2>{siteData.runLabel}</h2>
          <p>Published {siteData.publishedAtHuman}. This portal keeps the wiki depth, but presents it through the ZackAI brand system instead of a generic docs shell.</p>
        </div>
        <div class="closing-banner__actions">
          <a class="cta cta--secondary" href={siteData.docsHomeHref || '/docs/index'}>Open docs index</a>
          <a class="cta cta--primary" href={siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts'}>Open research hub</a>
        </div>
      </GlassCard>
    </section>
  </section>
</BaseLayout>
