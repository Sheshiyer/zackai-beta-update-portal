---
import { getCollection } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';
import { localizedDocTitle, normalizeLocale, t } from '../../../i18n';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const locales = ['en', 'fr'];
  return locales.flatMap((locale) =>
    docs.map((doc) => ({
      params: { locale, slug: doc.slug },
      props: { doc, locale },
    })),
  );
}

const { doc, locale: routeLocale } = Astro.props;
const locale = normalizeLocale(routeLocale);
const { Content, headings } = await doc.render();
const copy = t(locale);
const title = localizedDocTitle(locale, doc.slug, doc.data.title);
const category = copy.categories[(doc.data.category || 'general') as keyof typeof copy.categories] || doc.data.category;
---

<DocLayout
  title={title}
  description={doc.data.description}
  category={category}
  headings={headings}
  locale={locale}
>
  <Content />
</DocLayout>
