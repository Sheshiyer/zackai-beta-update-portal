---
interface Props {
  category?: string;
  title: string;
}

const { category, title } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">Portal</a>
  {category && <><span>/</span><span>{category}</span></>}
  <span>/</span>
  <span class="breadcrumb__current">{title}</span>
</nav>
