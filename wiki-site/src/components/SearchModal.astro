---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n';
import { localizedPath, localizedDocTitle } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const docs = await getCollection('docs');
const frDocs = await getCollection('frDocs');
const frDocsBySlug = new Map(frDocs.map((entry) => [entry.slug, entry]));

const searchIndex = docs.map((doc) => {
  const localized = locale === 'fr' ? frDocsBySlug.get(doc.slug) : undefined;
  const title = localized?.data.title || doc.data.title;
  const description = localized?.data.description || doc.data.description || '';
  const category = doc.data.category || 'general';
  return {
    slug: doc.slug,
    title,
    description,
    category,
    href: localizedPath(locale, `/docs/${doc.slug}`),
    icon: doc.data.icon || '',
  };
});
---

<div class="search-overlay" id="search-overlay">
  <div class="search-modal">
    <div class="search-input-wrapper">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"/>
        <path d="M21 21l-4.35-4.35"/>
      </svg>
      <input
        type="text"
        class="search-input"
        id="search-input"
        placeholder={locale === 'fr' ? 'Rechercher dans la documentation...' : 'Search documentation...'}
        autocomplete="off"
      />
      <kbd class="search-kbd">ESC</kbd>
    </div>
    <div class="search-results" id="search-results">
      <div class="search-hint" id="search-hint">
        {locale === 'fr' ? 'Tapez pour chercher...' : 'Type to search...'}
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchIndex, locale }}>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const resultsContainer = document.getElementById('search-results');
  const hint = document.getElementById('search-hint');

  function openSearch() {
    overlay.classList.add('open');
    input.focus();
    input.value = '';
    resultsContainer.innerHTML = '';
    if (hint) resultsContainer.appendChild(hint);
    hint.style.display = '';
  }

  function closeSearch() {
    overlay.classList.remove('open');
  }

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (overlay.classList.contains('open')) {
        closeSearch();
      } else {
        openSearch();
      }
    }
    if (e.key === 'Escape') {
      closeSearch();
    }
  });

  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeSearch();
  });

  // Wire up the search trigger button
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('search-trigger');
    if (trigger) trigger.addEventListener('click', openSearch);
  });

  input.addEventListener('input', () => {
    const query = input.value.toLowerCase().trim();
    if (!query) {
      resultsContainer.innerHTML = '';
      if (hint) { resultsContainer.appendChild(hint); hint.style.display = ''; }
      return;
    }
    if (hint) hint.style.display = 'none';

    const results = searchIndex.filter((doc) => {
      return (
        doc.title.toLowerCase().includes(query) ||
        doc.description.toLowerCase().includes(query) ||
        doc.category.toLowerCase().includes(query) ||
        doc.slug.toLowerCase().includes(query)
      );
    });

    resultsContainer.innerHTML = results.length
      ? results
          .map(
            (doc) => `
        <a href="${doc.href}" class="search-result-item">
          <span class="search-result-icon">${doc.icon || '📄'}</span>
          <span class="search-result-text">
            <strong>${highlightMatch(doc.title, query)}</strong>
            <small>${doc.category} · ${highlightMatch(doc.description.slice(0, 100), query)}${doc.description.length > 100 ? '...' : ''}</small>
          </span>
        </a>
      `
          )
          .join('')
      : `<div class="search-no-results">${locale === 'fr' ? 'Aucun résultat pour' : 'No results for'} "${input.value}"</div>`;
  });

  function highlightMatch(text, query) {
    if (!query) return text;
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
  }
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
    z-index: 100;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .search-overlay.open {
    opacity: 1;
    visibility: visible;
  }
  .search-modal {
    width: 100%;
    max-width: 640px;
    margin: 0 var(--space-4);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(32px) saturate(200%);
    -webkit-backdrop-filter: blur(32px) saturate(200%);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    overflow: hidden;
    transform: scale(0.96) translateY(-10px);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .search-overlay.open .search-modal {
    transform: scale(1) translateY(0);
  }
  [data-theme="dark"] .search-modal {
    background: rgba(40, 40, 44, 0.92);
    border-color: rgba(255, 255, 255, 0.1);
  }
  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--surface-border);
    color: var(--text-muted);
  }
  .search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: inherit;
    font-size: 1.05rem;
    color: var(--text-strong);
  }
  .search-input::placeholder {
    color: var(--text-soft);
  }
  .search-kbd {
    padding: 2px 8px;
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    background: var(--surface-card-strong);
    border-radius: var(--radius-xs);
    color: var(--text-muted);
    border: 1px solid var(--surface-border);
  }
  .search-results {
    max-height: 400px;
    overflow-y: auto;
    padding: var(--space-2);
  }
  .search-hint,
  .search-no-results {
    padding: var(--space-5) var(--space-4);
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .search-result-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-body);
    transition: background 0.15s;
  }
  .search-result-item:hover {
    background: var(--surface-card-strong);
  }
  .search-result-icon {
    font-size: 1.2rem;
    padding-top: 2px;
  }
  .search-result-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .search-result-text strong {
    color: var(--text-strong);
    font-size: 0.95rem;
  }
  .search-result-text small {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.3;
  }
  .search-result-text mark {
    background: color-mix(in srgb, var(--brand-accent) 25%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
