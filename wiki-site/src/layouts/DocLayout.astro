---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Props {
  title: string;
  description?: string;
  category?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, category, headings = [] } = Astro.props;
const content = await Astro.slots.render('default');
const wordCount = content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 210));
---

<BaseLayout title={title} description={description}>
  <section class="doc-stage">
    <div class="doc-shell">
      <article class="doc-panel glass-panel">
        <Breadcrumb title={title} category={category} />

        <header class="doc-header">
          <div class="doc-header__meta">
            {category && <span class="pill pill--soft">{category}</span>}
            <span class="pill pill--warm">{readingTime} min read</span>
          </div>
          <h1>{title}</h1>
          {description && <p class="doc-description">{description}</p>}
        </header>

        <div class="prose portal-prose">
          <slot />
        </div>
      </article>

      {headings.length > 0 && (
        <div class="doc-sidebar">
          <TableOfContents headings={headings} />
        </div>
      )}
    </div>
  </section>
</BaseLayout>
